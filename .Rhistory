library(FITSio)
library(ggplot2)
library(dplyr)
# Read top 100 matches
results <- read.csv("hw4best100.csv", header = FALSE)
colnames(results) <- c("score", "spectrumID", "shift")
# Load template spectrum
cB58 <- readFrameFromFITS("cB58_Lyman_break.fit")
# Standardize flux
cB58_flux <- cB58$FLUX
cB58_std <- (cB58_flux - mean(cB58_flux)) / sd(cB58_flux)
# Length of template
n <- length(cB58_std)
# Order based on best visual match (best first)
visual_order <- c(
"spec-3976-55302-0810.fits",
"spec-4766-55677-0472.fits",
"spec-5783-56017-0903.fits",
"spec-5785-56269-0553.fits",
"spec-6052-56092-0294.fits",
"spec-6055-56102-0884.fits",
"spec-6184-56267-0854.fits",
"spec-6303-56539-0090.fits",
"spec-6617-56365-0748.fits",
"spec-7400-57134-0696.fits"
)
# Extract corresponding rows
top10 <- results[match(visual_order, results$spectrumID), ]
par(mfrow = c(5, 2), mar = c(3, 3, 2, 1))  # 10 plots layout
for (i in 1:nrow(top10)) {
file <- top10$spectrumID[i]
shift_val <- top10$shift[i]
# Load observed spectrum
spec <- readFrameFromFITS(paste0("data/", file))
# Standardize observed flux
spec_flux <- spec$FLUX
spec_std <- (spec_flux - mean(spec_flux)) / sd(spec_flux)
# Plot observed spectrum
plot(spec_std, type = "l", col = "blue",
main = paste("Match", i),
xlab = "Index",
ylab = "Standardized Flux")
# Overlay shifted cB58 template
lines(x = shift_val + (1:n),
y = cB58_std,
col = "red",
lwd = 1.5)
# Legend
legend("topright",
legend = c("Observed Spectrum", "cB58 Template"),
col = c("blue", "red"),
lty = 1,
cex = 0.8,
bg = "white")
}
results <- read.csv("hw4best100.csv", header = FALSE)
colnames(results) <- c("score", "spectrumID", "shift")
# take top 10
top10 <- results %>% head(10)
cB58 <- readFrameFromFITS("cB58_Lyman_break.fit")
cB58_flux <- cB58$FLUX
cB58_wave <- cB58$WAVELENGTH  # adjust if your column name differs
cB58_std <- scale(cB58_flux)[,1]
get_plate <- function(filename) {
# spec-1234-56789-0123.fits → 1234
strsplit(filename, "-")[[1]][2]
}
make_plot <- function(file, rank_label) {
sp <- readFrameFromFITS(file)
flux <- sp$FLUX
wave <- sp$WAVELENGTH  # adjust if needed
flux_std <- scale(flux)[,1]
# align lengths (simple truncation for safety)
n <- min(length(wave), length(cB58_wave))
df <- data.frame(
wave = wave[1:n],
cB58 = cB58_std[1:n],
target = flux_std[1:n]
)
ggplot(df, aes(x = wave)) +
geom_line(aes(y = cB58, color = "cB58")) +
geom_line(aes(y = target, color = "Target Spectrum")) +
labs(
title = paste("Match Rank:", rank_label),
color = "Legend"
) +
theme_minimal()
}
plots <- list()
for (i in 1:10) {
file <- top10$spectrumID[i]
plots[[i]] <- make_plot(file, i)
}
View(plots)
