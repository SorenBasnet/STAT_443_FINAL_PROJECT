library(FITSio)
best100 <- read.csv("hw4best100.csv", header = FALSE,
col.names = c("distance", "spectrumID", "i"))
# Read and standardize the cB58 template
cB58        <- readFrameFromFITS("cB58_Lyman_break.fit")
cB58_std    <- (cB58$FLUX - mean(cB58$FLUX)) / sd(cB58$FLUX)
n           <- length(cB58_std)
cat("Top 10 matches:\n")
print(head(best100, 10))
top10 <- head(best100, 10)
# --- Reorder by visual quality here if desired ---
# e.g., top10 <- top10[c(1, 3, 2, 4, 5, 6, 7, 8, 9, 10), ]
for (k in seq_len(nrow(top10))) {
file      <- top10$spectrumID[k]
shift_val <- top10$i[k]
noisy     <- readFrameFromFITS(file)
flux_col  <- if (!is.null(noisy$flux)) noisy$flux else noisy$FLUX
stn_noisy <- (flux_col - mean(flux_col)) / sd(flux_col)
plot(stn_noisy, type = "l", col = "blue",
main  = paste0("Rank ", k, ": cB58 vs ", file,
"  (distance = ", round(top10$distance[k], 1), ")"),
xlab  = "Index",
ylab  = "Standardized Flux")
lines(x = shift_val + seq_len(n),
y = cB58_std,
col = "red")
legend("topright",
legend = c(file, "cB58"),
col    = c("blue", "red"),
lty    = 1)
}
